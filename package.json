{
  "name": "dsh-usage-state",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "DSH plugin: show account balance (API mode) or coding-plan quota (5h/7d/30d) for the model in use",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --import ./tests/support/client-render-hook.mjs --test",
    "test:watch": "node --import ./tests/support/client-render-hook.mjs --test --watch",
    "typecheck": "tsc --noEmit",
    "build": "node -e \"require('node:fs').rmSync('lib',{recursive:true,force:true})\" && tsdown",
    "watch": "tsdown --watch"
  },
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./typert": {
      "default": "./lib/typert.js"
    },
    "./package.json": "./package.json"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-client-locale": "^0.1.5-rc.2",
    "@deepseek-ai/dsh-client-store": "^0.1.5-rc.2",
    "@deepseek-ai/dsh-client-ui-conversation": "^0.1.5-rc.2",
    "@deepseek-ai/dsh-client-ui-primitives": "^0.1.5-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "^0.1.5-rc.2",
    "@deepseek-ai/dsh-typert-loader": "^0.1.5-rc.2",
    "@types/node": "^24.0.0",
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.1",
    "react": "^18.3.1",
    "react-dom": "^18.2.0",
    "tsdown": "^0.22.14",
    "typescript": "^5.9.2",
    "unrun": "^0.2.39"
  },
  "dependencies": {
    "zod": "4.5.1"
  },
  "main": "lib/index.js",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "LICENSE",
    "docs/adapters.md"
  ],
  "peerDependencies": {
    "react": "^18.2.0"
  },
  "keywords": [
    "deepseek",
    "dsh",
    "dsh-plugin",
    "usage",
    "balance",
    "quota",
    "coding-plan"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/takboo/dsh-usage-state.git"
  },
  "homepage": "https://github.com/takboo/dsh-usage-state#readme",
  "bugs": {
    "url": "https://github.com/takboo/dsh-usage-state/issues"
  }
}
